{
  "name": "fortytwo-openclaw",
  "version": "0.1.0",
  "description": "Fortytwo Chat Completions provider for OpenClaw.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "node": "24.22.1",
    "openclaw": "2026.10.9",
    "vitest": "4.1.10"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fortytwo-Network/fortytwo-openclaw.git"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "fortytwo-openclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.9"
    },
    "compat": {
      "pluginApi": ">=2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9"
    }
  },
  "allowScripts": {
    "node": true
  }
}
